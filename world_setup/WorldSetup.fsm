"""
Librarian field: two ArUco reference markers relative to the robot start pose.

Physical layout (inches): forward offset 6.5 in, lateral ±3.5 in from start.
In the AIM world frame used here, both markers share ``x = +6.5`` in and ``y = ±3.5`` in (converted to mm).

The markers sit on the side **opposite the camera** from an earlier ArUco placement: the
forward component is negated so the markers are **behind** the robot (camera looks toward
+y at heading 0 in this convention; markers share ``x = +6.5`` in forward distance, with
lateral ``y = ±3.5`` in).

**ArUco ids 19 and 20** (OpenCV dictionary on the field), not VEX AprilTag/AIV ``tag`` objects.
World objects are ``ArucoMarkerObj``. The particle viewer lists fixed landmark poses;
measurement updates use :class:`ArucoCombinedSensorModel` (combined distance/bearing; not ``ArucoDistanceSensorModel`` alone).

Both markers use the **same positive x** (``_TAG_Y``). **Different y** (``±_TAG_X``) places them on **either side** of the robot start laterally (id 19 at ``+y``, id 20 at ``-y``).

Regenerate Python with::

    python3 path/to/vex-aim-tools/genfsm WorldSetup.fsm WorldSetup.py
"""

from math import radians

from aim_fsm import *
from aim_fsm.particle import ArucoCombinedSensorModel

_TAG_Y = 138  
_TAG_X = 175  
BOX_WIDTH = 35

# Match ``CelesteLibrarian`` field shift; marker 16: X = −3 cm; Y and theta = marker 20.
SETUP_SHIFT_X_MM = -30.0
SETUP_SHIFT_Y_MM = -30.0
HOMING_MARKER16_X_MM = -30.0
HOMING_MARKER_ID_SEED = 16


def marker20_y_mm() -> float:
    return _TAG_Y - BOX_WIDTH / 2 + SETUP_SHIFT_Y_MM


class WorldSetup(StateMachineProgram):
    def __init__(self):
        sx = SETUP_SHIFT_X_MM
        sy = SETUP_SHIFT_Y_MM
        m18_x = _TAG_X - BOX_WIDTH / 2 + sx
        m18_y = -_TAG_Y + sy
        m20_y = marker20_y_mm()
        landmarks = {
            'ArucoMarker-17': Pose(_TAG_X - BOX_WIDTH/2 + sx, _TAG_Y + sy, 5, radians(90)),
            'ArucoMarker-18': Pose(m18_x, m18_y, 5, radians(270)),
            'ArucoMarker-19': Pose(_TAG_X + sx, -_TAG_Y + BOX_WIDTH/2 + sy, 5, radians(180)),
            'ArucoMarker-20': Pose(_TAG_X + sx, m20_y, 5, radians(180)),
            'ArucoMarker-16': Pose(HOMING_MARKER16_X_MM, m20_y, 5, radians(180)),
        }
        pf = ParticleFilter(
            robot,
            num_particles=500,
            landmarks=landmarks,
            sensor_model=ArucoCombinedSensorModel,
        )
        
        super().__init__(
            particle_filter=pf,
            wall_marker_dict=None,
            speech=False,
            launch_particle_viewer=True,
        )

    def start(self):

        super().start()
        sx = SETUP_SHIFT_X_MM
        sy = SETUP_SHIFT_Y_MM
        m18_x = _TAG_X - BOX_WIDTH/2 + sx
        m18_y = -_TAG_Y + sy
        m20_y = marker20_y_mm()
        m17 = ArucoMarkerObj({'name': 'ArucoMarker-17', 'id': 17, 'marker': None}, x=_TAG_X - BOX_WIDTH/2 + sx, y=_TAG_Y + sy, theta=radians(90))
        m18 = ArucoMarkerObj({'name': 'ArucoMarker-18', 'id': 18, 'marker': None}, x=m18_x, y=m18_y, theta=radians(270))
        m17.is_fixed = True
        m18.is_fixed = True
        self.robot.world_map.objects['ArucoMarker-17.a'] = m17
        self.robot.world_map.objects['ArucoMarker-18.a'] = m18
        m16 = ArucoMarkerObj(
            {'name': f'ArucoMarker-{HOMING_MARKER_ID_SEED}', 'id': HOMING_MARKER_ID_SEED, 'marker': None},
            x=HOMING_MARKER16_X_MM,
            y=m20_y,
            z=5,
            theta=radians(180),
        )
        m16.is_fixed = True
        self.robot.world_map.objects[f'ArucoMarker-{HOMING_MARKER_ID_SEED}.a'] = m16
        m19 = ArucoMarkerObj({'name': 'ArucoMarker-19', 'id': 19, 'marker': None}, x=_TAG_X + sx, y=-_TAG_Y + BOX_WIDTH/2 + sy, theta=radians(180))
        m20 = ArucoMarkerObj({'name': 'ArucoMarker-20', 'id': 20, 'marker': None}, x=_TAG_X + sx, y=m20_y, theta=radians(180))
        m19.is_fixed = True
        m20.is_fixed = True
        self.robot.world_map.objects['ArucoMarker-19.a'] = m19
        self.robot.world_map.objects['ArucoMarker-20.a'] = m20

    $setup{
        done: ParentCompletes()
    }
